{
    "engines": {"lucee": {
        "docs": "https://docs.lucee.org/reference/functions/fileread.html",
        "minimum_version": ""
    }},
    "name": "fileRead",
    "description": "Reads an on-disk or in-memory text file or a file object created with the FileOpen function.",
    "syntax": "fileRead( any file, [any charsetOrBufferSize] )",
    "returns": "any",
    "type": "function",
    "params": [
        {
            "name": "file",
            "description": "file path or object",
            "type": "any",
            "required": true
        },
        {
            "name": "charsetOrBufferSize",
            "description": "the charset used or the size of the buffer.",
            "type": "any",
            "required": false
        }
    ]
}