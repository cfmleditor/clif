{
    "engines": {"lucee": {
        "docs": "https://docs.lucee.org/reference/tags/invokeargument.html",
        "minimum_version": ""
    }},
    "name": "cfinvokeargument",
    "description": "Argument for the Invoke Tag",
    "syntax": "<cfinvokeargument name=\"\", value=\"\"/>",
    "returns": "void",
    "type": "tag",
    "params": [
        {
            "name": "name",
            "description": "name of the argument",
            "default": false,
            "type": "string",
            "required": true
        },
        {
            "name": "value",
            "description": "value of the argument",
            "default": false,
            "type": "any",
            "required": true
        },
        {
            "name": "omit",
            "description": "Enables you to omit a parameter when invoking a web service",
            "default": false,
            "type": "boolean",
            "required": false
        }
    ],
    "body": "none"
}