{
    "engines": {"lucee": {
        "docs": "https://docs.lucee.org/reference/functions/getpropertystring.html",
        "minimum_version": "7.0.0.108"
    }},
    "name": "getPropertyString",
    "description": "Gets the value of a property entry from a properties file.",
    "syntax": "getPropertyString( string filePath, string key, [string encoding] )",
    "returns": "string",
    "type": "function",
    "params": [
        {
            "name": "filePath",
            "description": "Path of the properties file",
            "type": "string",
            "required": true
        },
        {
            "name": "key",
            "description": "Name of the key to return",
            "type": "string",
            "required": true
        },
        {
            "name": "encoding",
            "description": "Encoding for the properties file",
            "default": "UTF-8",
            "type": "string",
            "required": false
        }
    ]
}