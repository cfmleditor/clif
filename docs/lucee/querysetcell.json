    "name": "querySetCell",
    "description": "Sets a cell to a value. If no row number is specified, the cell on the last row is set.",
    "syntax": "querySetCell( query query, string column_name, any value, [number row_number] )",
    "returns": "boolean",
    "type": "function",
    "params": [
        {
            "name": "query",
            "description": "Name of an executed query.",
