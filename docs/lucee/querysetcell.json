            "type": "query",
            "required": true
        },
        {
            "name": "column_name",
            "description": "Name of the column to populate.",
            "aliases": "columnName",
            "type": "string",
            "required": true
        },
        {
            "name": "value",
            "description": "The value to populate the query cell with.",
            "type": "any",
            "required": true
        },
        {
            "name": "row_number",
            "description": "Query row number to populate.",
            "default": "-9999",
