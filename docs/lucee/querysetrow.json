{
    "member_details": {
        "name": "setRow",
        "type": "query",
        "returns": "query"
    },
    "engines": {"lucee": {
        "docs": "https://docs.lucee.org/reference/functions/querysetrow.html",
        "minimum_version": "5.3.8.120"
