    "name": "querySetRow",
    "description": "Adds a row to a query, either by struct or array",
    "syntax": "querySetRow( query query, any rowData, [number rowNumber] )",
    "returns": "boolean",
    "type": "function",
    "params": [
        {
            "name": "query",
            "description": "query object to set row",
            "type": "query",
            "required": true
        },
        {
            "name": "rowNumber",
            "description": "position of the row to updated, otherwise a new row is added",
            "default": "0",
            "aliases": "row",
            "type": "number",
            "required": false
        },
        {
            "name": "rowData",
            "description": "a struct or array",
            "aliases": "data",
            "type": "any",
            "required": true
        }
    ]
}