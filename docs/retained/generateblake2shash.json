{
    "name": "GenerateBlake2sHash",
    "description": "Generates a Blake2s hash. Blake2s is optimized for 32-bit platforms and embedded systems.",
    "syntax": "GenerateBlake2sHash( any input, [numeric outputLength], [any key] )",
    "returns": "string",
    "type": "function",
    "params": [
        {
            "name": "input",
            "description": "Data to hash (string or binary)",
            "type": "any",
            "required": true
        },
        {
            "name": "outputLength",
            "description": "Output length in bytes (1-32, default 32)",
            "type": "numeric",
            "required": false
        },
        {
            "name": "key",
            "description": "Key for keyed hash mode (MAC), max 32 bytes",
            "type": "any",
            "required": false
        }
    ]
}
