{
    "name": "GenerateBlake2bHash",
    "description": "Generates a Blake2b hash. Blake2b is optimized for 64-bit platforms, faster than SHA-256 while being at least as secure.",
    "syntax": "GenerateBlake2bHash( any input, [numeric outputLength], [any key] )",
    "returns": "string",
    "type": "function",
    "params": [
        {
            "name": "input",
            "description": "Data to hash (string or binary)",
            "type": "any",
            "required": true
        },
        {
            "name": "outputLength",
            "description": "Output length in bytes (1-64, default 32)",
            "type": "numeric",
            "required": false
        },
        {
            "name": "key",
            "description": "Key for keyed hash mode (MAC), max 64 bytes",
            "type": "any",
            "required": false
        }
    ]
}
