 func (pr *ParseResult) scriptTokens(r *Region) *[]Token {
+	if tokens := pr.captured[r.Offset]; tokens != nil {
+		delete(pr.captured, r.Offset)
+		tapeReuseHits++
+		if probeVerify && !slices.Equal(tokens, tokenize(r.Text)) {
+			probeMismatch++
+		}
+		return publishTokens(r.Text, tokens)
+	}
+
 	if len(r.Text) >= sharedTokenMin {
+		if probeVerify {
+			sharedTokens.mu.Lock()
+			if sharedTokens.find(r.Text) == nil {
+				probeMissedDemand++
+			}
+			sharedTokens.mu.Unlock()
+		}
 		return scriptTokensOf(r.Text)
 	}

