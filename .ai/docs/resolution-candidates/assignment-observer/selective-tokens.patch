diff --git a/internal/parser/tape_probe.go b/internal/parser/tape_probe.go
new file mode 100644
index 0000000..38d553d
--- /dev/null
+++ b/internal/parser/tape_probe.go
@@ -0,0 +1,55 @@
+package parser
+
+// Instrumentation for the single-threaded corpus and benchmark probes.
+var probeEnabled, probeVerify bool
+var probeAttempts, probeIncomplete, probeMismatch, probeCacheHits, probeMissedDemand int
+
+func (pr *ParseResult) shouldCapture(text string) bool {
+	sharedTokens.mu.Lock()
+	hit := sharedTokens.find(text) != nil
+	sharedTokens.mu.Unlock()
+	if hit {
+		probeCacheHits++
+		return false
+	}
+	if !pr.probeDemandChecked {
+		// Only use evidence available before parsing, excluding refs yet to be collected.
+		early := ParseResult{FuncLookup: pr.FuncLookup, Resolvers: pr.Resolvers}
+		pr.probeDemand = early.hasMemberBinding(pr.Content)
+		pr.probeDemandChecked = true
+	}
+	return pr.probeDemand
+}
+
+type checkedTape struct {
+	tokens     []Token
+	end        int
+	line       int32
+	incomplete bool
+	done       bool
+}
+
+func (t *checkedTape) record(sc *Scanner, from int, line int32, tok Token) {
+	if t.done || t.incomplete {
+		return
+	}
+	if sc.pos <= t.end && tok.Kind != TokEOF {
+		return
+	}
+	if from != t.end || line != t.line || !sc.interpStrings || len(sc.aux.scriptSpans) != 0 {
+		t.incomplete = true
+		return
+	}
+	t.tokens = append(t.tokens, tok)
+	t.end, t.line = sc.pos, sc.line
+	t.done = tok.Kind == TokEOF
+}
+
+func (t *checkedTape) complete() []Token {
+	if t.done && !t.incomplete {
+		return t.tokens
+	}
+	return nil
+}
+
+var tapeReuseHits int
diff --git a/internal/parser/tape_probe_test.go b/internal/parser/tape_probe_test.go
new file mode 100644
index 0000000..df08e60
--- /dev/null
+++ b/internal/parser/tape_probe_test.go
@@ -0,0 +1,127 @@
+package parser
+
+import (
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"go.lsp.dev/uri"
+)
+
+func TestMainParseTokenTapeProbe(t *testing.T) {
+	for _, withLookup := range []bool{false, true} {
+		name := "calls"
+		opts := &ParseOptions{ExtractCalls: true}
+		if withLookup {
+			name = "calls-with-lookup"
+			opts.FuncLookup = func(string, string) string { return "" }
+		}
+		t.Run(name, func(t *testing.T) { probeCorpus(t, opts) })
+	}
+}
+func probeCorpus(t *testing.T, opts *ParseOptions) {
+	previous := SetSharedTokenLimit(0)
+	SetSharedTokenLimit(previous)
+	probeEnabled, probeVerify = true, true
+	defer func() { probeEnabled, probeVerify = false, false }()
+	probeMissedDemand = 0
+	var files, total, unused int
+	probeAttempts, probeIncomplete, probeMismatch, probeCacheHits, tapeReuseHits = 0, 0, 0, 0, 0
+	for _, root := range filepath.SplitList(os.Getenv("CLIF_ASSIGN_PROBE_ROOTS")) {
+
+		err := filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {
+			if err != nil {
+				return err
+			}
+			if entry.IsDir() {
+				if entry.Name() == ".git" || entry.Name() == "node_modules" {
+					return filepath.SkipDir
+				}
+				return nil
+			}
+			ext := strings.ToLower(filepath.Ext(path))
+			if ext != ".cfc" && ext != ".cfm" {
+				return nil
+			}
+			data, err := os.ReadFile(path)
+			if err != nil {
+				return err
+			}
+			if len(data) > 2<<20 {
+				return nil
+			}
+
+			files++
+			pr := ParseWithOptions(uri.File(path), string(data), opts)
+			for _, r := range pr.Regions {
+				if r.Kind != RegionScript {
+					continue
+				}
+				total++
+			}
+			unused += len(pr.captured)
+			return nil
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	t.Logf("files=%d regions=%d cache-hits=%d attempts=%d exact-reused=%d incomplete=%d unused=%d mismatches=%d standalone-large-misses=%d", files, total, probeCacheHits, probeAttempts, tapeReuseHits, probeIncomplete, unused, probeMismatch, probeMissedDemand)
+	if tapeReuseHits == 0 || probeMismatch != 0 || unused != 0 || probeAttempts != tapeReuseHits+probeIncomplete {
+		t.Fatal("selective capture failed")
+	}
+}
+
+func BenchmarkCollectionTokenReuseProbe(b *testing.B) {
+	file := os.Getenv("CLIF_ASSIGN_PROBE_CONTROLLER")
+	data, err := os.ReadFile(file)
+	if err != nil {
+		b.Fatal(err)
+	}
+	u := uri.File(file)
+	original := string(data)
+	edited := strings.Replace(original, "\n\t// BoxLang Detection", "\n \t// BoxLang Detection", 1)
+	if edited == original {
+		b.Fatal("fixture edit did not apply")
+	}
+	for _, cache := range []struct {
+		name  string
+		texts []string
+	}{
+		{"warm", []string{original, edited}},
+		{"cold", make([]string, 32)},
+		{"unused", []string{"component { function f(){ var n = 1; } }" + strings.Repeat(" ", sharedTokenMin)}},
+	} {
+		if cache.name == "cold" {
+			for i := range cache.texts {
+				cache.texts[i] = strings.Replace(original, "\n\t// BoxLang Detection", "\n"+strings.Repeat(" ", i+1)+"\t// BoxLang Detection", 1)
+			}
+		}
+		for _, mode := range []string{"baseline", "checked_tape"} {
+			b.Run(cache.name+"/"+mode, func(b *testing.B) {
+				probeEnabled = mode == "checked_tape"
+				defer func() { probeEnabled = false }()
+				if cache.name == "warm" {
+					for _, text := range cache.texts {
+						ParseWithOptions(u, text, &ParseOptions{ExtractCalls: true})
+					}
+				}
+				tapeReuseHits, probeAttempts = 0, 0
+				b.ReportAllocs()
+				i := 0
+				for b.Loop() {
+					ParseWithOptions(u, cache.texts[i], &ParseOptions{ExtractCalls: true})
+
+					i = (i + 1) % len(cache.texts)
+				}
+				b.ReportMetric(float64(tapeReuseHits)/float64(b.N), "tape-reads/op")
+				b.ReportMetric(float64(probeAttempts)/float64(b.N), "attempts/op")
+				if mode == "checked_tape" && ((cache.name == "cold" && tapeReuseHits == 0) || (cache.name != "cold" && probeAttempts != 0)) {
+					b.Fatal("checked tape was unused")
+				}
+			})
+		}
+	}
+}
