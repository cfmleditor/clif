+package parser
+
+import (
+	"io/fs"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/cfmleditor/clif/internal/lex"
+	"github.com/cfmleditor/clif/internal/vfs"
+	"go.lsp.dev/uri"
+)
+
+// Read the target and expression only at offsets the parser visited as
+// assignments. Reuse the current expression boundary rule.
+func probeWrites(src string, sites []int, toks []Token) []expressionWrite {
+	if len(sites) == 0 {
+		return nil
+	}
+	slices.Sort(sites)
+	sites = slices.Compact(sites)
+	ends := newExpressionEndsFrom(src, toks)
+	sc := newReplayScanner(src, &toks)
+	var writes []expressionWrite
+	for _, site := range sites {
+		i, found := slices.BinarySearchFunc(toks, site, func(tok Token, at int) int { return tok.Offset - at })
+		if !found || i > 0 && (toks[i-1].Kind == TokDot || toks[i-1].Kind == TokDoubleColon) {
+			continue
+		}
+		t := toks[i]
+		sc.Restore(ScannerState{pos: site, line: int(t.Line)})
+		root, elem := collectionTarget(sc)
+		local := identEq(t.Value, "var")
+		if local {
+			root, elem = collectionTarget(sc)
+		}
+		if root == "" || sc.NextSkipComments().Kind != TokEquals || sc.PeekSkipComments().Kind == TokEquals {
+			continue
+		}
+		local = local || lex.HasPrefixFold(root, "local.")
+		writes = append(writes, expressionWrite{write: collectionWrite{
+			target: root, expression: ends.from(sc.PeekSkipComments().Offset), element: elem, local: local,
+		}, at: site, placed: true})
+	}
+	return writes
+}
+
+func TestAssignmentObserverCorpusProbe(t *testing.T) {
+	type counts struct {
+		files, scripts, mismatch, mismatchedFiles, exact, baseline, candidate int
+		missing, extra, unknown, element                                      int
+	}
+	var totals counts
+	for _, root := range filepath.SplitList(os.Getenv("CLIF_ASSIGN_PROBE_ROOTS")) {
+		if root == "" {
+			continue
+		}
+		var c counts
+		err := filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {
+			if err != nil {
+				return err
+			}
+			if entry.IsDir() {
+				if entry.Name() == ".git" || entry.Name() == "node_modules" {
+					return filepath.SkipDir
+				}
+				return nil
+			}
+			ext := strings.ToLower(filepath.Ext(path))
+			if ext != ".cfc" && ext != ".cfm" {
+				return nil
+			}
+			data, err := vfs.ReadCorpusFile(path)
+			if vfs.SkipCorpusFile(err) {
+				return nil
+			}
+			if err != nil {
+				return err
+			}
+			c.files++
+			probeAssignmentSites = make(map[int][]int)
+			pr := ParseWithOptions(uri.File(path), string(data), &ParseOptions{ExtractCalls: true})
+			fileMismatch := false
+			for _, r := range pr.Regions {
+				if r.Kind != RegionScript {
+					continue
+				}
+				c.scripts++
+				toks := scriptTokensOf(r.Text)
+				base := scanExpressionWritesFrom(newReplayScanner(r.Text, toks), r.Text, *toks)
+				candidate := probeWrites(r.Text, probeAssignmentSites[r.Offset], *toks)
+				c.baseline += len(base)
+				c.candidate += len(candidate)
+				if slices.Equal(base, candidate) {
+					c.exact++
+					continue
+				}
+				c.mismatch++
+				fileMismatch = true
+				observed := map[expressionWrite]int{}
+				for _, got := range candidate {
+					observed[got]++
+				}
+				for _, expected := range base {
+					if observed[expected] > 0 {
+						observed[expected]--
+						continue
+					}
+					c.missing++
+					if expected.write.unknown {
+						c.unknown++
+					}
+					if expected.write.element {
+						c.element++
+					}
+					if c.missing <= 10 {
+						t.Logf("%s byte %d missing target=%q unknown=%v element=%v expression prefix=%q",
+							filepath.Base(path), r.Offset+expected.at, expected.write.target, expected.write.unknown,
+							expected.write.element, expected.write.expression[:min(85, len(expected.write.expression))])
+					}
+				}
+				for _, n := range observed {
+					c.extra += n
+				}
+			}
+			if fileMismatch {
+				c.mismatchedFiles++
+			}
+			probeAssignmentSites = nil
+			return nil
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Logf("%s files=%d script-regions=%d exact=%d changed-regions=%d changed-files=%d baseline=%d observer=%d missing=%d extra=%d unknown-missing=%d element-missing=%d",
+			filepath.Base(root), c.files, c.scripts, c.exact, c.mismatch, c.mismatchedFiles, c.baseline, c.candidate, c.missing, c.extra, c.unknown, c.element)
+		totals.files += c.files
+		totals.scripts += c.scripts
+		totals.exact += c.exact
+		totals.mismatch += c.mismatch
+		totals.mismatchedFiles += c.mismatchedFiles
+		totals.baseline += c.baseline
+		totals.candidate += c.candidate
+		totals.missing += c.missing
+		totals.extra += c.extra
+		totals.unknown += c.unknown
+		totals.element += c.element
+	}
+	if totals.files == 0 {
+		t.Fatal("no files read")
+	}
+	t.Logf("total %+v", totals)
+}
