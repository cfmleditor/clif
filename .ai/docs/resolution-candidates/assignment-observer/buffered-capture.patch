+
+func TestBufferedCaptureOwnsPublishedTokens(t *testing.T) {
+	text := "x = new Thing();"
+	want := tokenize(text)
+	scratch := &checkedTape{tokens: append([]Token(nil), want...), done: true}
+	backing := scratch.tokens
+	published := scratch.takeTokens()
+	for _, token := range backing {
+		if token != (Token{}) {
+			t.Fatal("scratch retains source text after release")
+		}
+	}
+	if !slices.Equal(published, want) || cap(published) != len(want) {
+		t.Fatal("published tokens must own exact-sized storage")
+	}
+}
