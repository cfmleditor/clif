diff --git a/internal/parser/tape_probe.go b/internal/parser/tape_probe.go
index 38d553d..2d29a53 100644
--- a/internal/parser/tape_probe.go
+++ b/internal/parser/tape_probe.go
@@ -1,5 +1,7 @@
 package parser

+import "sync"
+
 // Instrumentation for the single-threaded corpus and benchmark probes.
 var probeEnabled, probeVerify bool
 var probeAttempts, probeIncomplete, probeMismatch, probeCacheHits, probeMissedDemand int
@@ -53,3 +55,26 @@ func (t *checkedTape) complete() []Token {
 }

 var tapeReuseHits int
+
+// Each active region owns its scratch until inference consumes it or the parse ends.
+var captureScratch = sync.Pool{New: func() any { return new(checkedTape) }}
+
+func (t *checkedTape) release() {
+	if cap(t.tokens) > 32<<10 {
+		return
+	}
+	clear(t.tokens)
+	*t = checkedTape{tokens: t.tokens[:0]}
+	captureScratch.Put(t)
+}
+
+// The shared cache can outlive this parse. Give it an independent, exact-sized slice.
+func (t *checkedTape) takeTokens() []Token {
+	tokens := make([]Token, len(t.tokens))
+	copy(tokens, t.tokens)
+	t.release()
+	return tokens
+}
+
+// Compare pooling alone with recording during the parser walk.
+var probePooledScan bool
